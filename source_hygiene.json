{
  "max_physical_lines": 1000,
  "preferred_line_length": 80,
  "source_extensions": [
    ".c",
    ".cc",
    ".cpp",
    ".cs",
    ".css",
    ".go",
    ".h",
    ".hpp",
    ".html",
    ".java",
    ".js",
    ".jsx",
    ".kt",
    ".kts",
    ".php",
    ".ps1",
    ".py",
    ".pyi",
    ".rb",
    ".rs",
    ".scss",
    ".sh",
    ".sql",
    ".svelte",
    ".swift",
    ".ts",
    ".tsx",
    ".vue"
  ],
  "exclude_paths": [
    ".git/**",
    ".mypy_cache/**",
    ".pytest_cache/**",
    ".ruff_cache/**",
    ".venv/**",
    ".vs/**",
    "__pycache__/**",
    "build/**",
    "dist/**",
    "generated/**",
    "node_modules/**",
    "third_party/**",
    "vendor/**",
    "vendored/**",
    "venv/**"
  ],
  "approved_exceptions": []
}

