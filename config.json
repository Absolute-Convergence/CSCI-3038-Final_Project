{
  "worker": {
    "command": [
      "python",
      "examples\\paper_airplane\\paper_airplane_worker.py"
    ],
    "metrics_argument": "--metrics-out",
    "timeout_seconds": 120.0
  },
  "optimization": {
    "parameters": [
      {
        "name": "wing_span_cm",
        "kind": "float",
        "minimum": 5.0,
        "maximum": 20.0
      },
      {
        "name": "nose_weight_g",
        "kind": "float",
        "minimum": 0.0,
        "maximum": 5.0
      },
      {
        "name": "wing_angle_deg",
        "kind": "float",
        "minimum": 0.0,
        "maximum": 45.0
      },
      {
        "name": "fold_sharpness",
        "kind": "float",
        "minimum": 0.0,
        "maximum": 1.0
      },
      {
        "name": "paper_thickness_gsm",
        "kind": "float",
        "minimum": 60.0,
        "maximum": 160.0
      }
    ],
    "objectives": [
      {
        "metric_name": "flight_distance_m",
        "direction": "maximize"
      },
      {
        "metric_name": "landing_accuracy_pct",
        "direction": "maximize"
      }
    ]
  },
  "algorithm": {
    "name": "nsga2",
    "seed": 42
  },
  "stop_policy": {
    "max_trials": 150
  }
}