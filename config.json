{
  "worker": {
    "command": [
      "C:\\Users\\wanna\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
      "C:\\dev\\final_proj\\CSCI-3038-Final_Project\\examples\\iris_torch\\iris_worker.py"
    ],
    "metrics_argument": "--metrics-out",
    "timeout_seconds": 120.0
  },
  "optimization": {
    "parameters": [
      {
        "name": "learning_rate",
        "kind": "float",
        "minimum": 0.0001,
        "maximum": 0.1
      },
      {
        "name": "hidden_size",
        "kind": "integer",
        "minimum": 4,
        "maximum": 128
      },
      {
        "name": "epochs",
        "kind": "integer",
        "minimum": 5,
        "maximum": 100
      },
      {
        "name": "batch_size",
        "kind": "categorical",
        "choices": [
          8,
          16,
          32
        ]
      }
    ],
    "objectives": [
      {
        "metric_name": "validation_accuracy",
        "direction": "maximize"
      },
      {
        "metric_name": "training_time_seconds",
        "direction": "minimize"
      }
    ]
  },
  "algorithm": {
    "name": "nsga2",
    "seed": 1
  },
  "stop_policy": {
    "max_trials": 5
  }
}